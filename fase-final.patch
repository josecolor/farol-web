+    // E. Rostros fuera de contexto (por leyenda): persona con nombre que la noticia no menciona, o retrato sin respaldo
+    const limpia = descr.split(/\s[|–—-]\s/)[0].slice(0, 220);                 // quita el sufijo "| Nombre del medio"
