+    const años = [...(corto.match(/(?<![0-9])(19[5-9]\d|20[0-3]\d)(?![0-9])/g) || [])].filter(a => !ctx.años.has(a));
+    const viejo = años.find(a => +a < ahora.getFullYear() - 1);
+    if (viejo) return { ok: false, motivo: `foto antigua (año ${viejo} en leyenda/URL)` };
