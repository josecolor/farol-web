+    US: /(?<![\p{L}])(?:USA|U\.S\.A?\.?|EE\.?\s?UU\.?)(?![\p{L}])/gu,
+    GB: /(?<![\p{L}])UK(?![\p{L}])/gu,
+    CN: /(?<![\p{L}])China(?![\p{L}])/gu,
