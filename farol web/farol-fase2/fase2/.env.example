# ── Ya existentes en Railway ──
DATABASE_URL=
REDIS_URL=
MONGO_URL=
BASE_URL=https://elfarolaldia.com.do

# ── FASE 2: Llama autohospedado (SIN API KEY) ──
LLM_BASE_URL=http://llama.railway.internal:11434
LLM_MODEL=llama3.1:8b
LLM_MODEL_FALLBACK=llama3.2:3b
LLM_NUM_CTX=8192

# ── FASE 2: imágenes ──
IMG_MIN_RELEVANCIA=0.5        # 0.3 = más permisivo, 0.7 = más estricto
IMG_MIN_ANCHO=1000
# IMG_DIR=/data/img           # solo si montas un Volume y NO usas Mongo
# PERMITIR_FLICKR=1           # no recomendado

# Ya NO hacen falta: GEMINI_API_KEY*, GOOGLE_CSE_*, PEXELS_API_KEY, UNSPLASH_ACCESS_KEY
